*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase5>
*** <desc> Transfer carries a delivery key -> GET.DELIVERY.DETAILS reads F.DE.O.HEADER for
            each id in the key and captures the disposition of an MT541/543 message</desc>

runtest5:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
    Y.GRP.ID = 'EQD.1.SEC0001.HKSCC.HKD.SEHK.CUST001.10.50.20260626.20260628.20260830'

    D.FIELDS = ''
    D.FIELDS<1,1> = 'TRADE.DATE'
    D.FIELDS<1,2> = 'SEC.TRADE.ID'
    D.RANGE.AND.VALUE = ''
    D.RANGE.AND.VALUE<1> = '20260626'
    D.RANGE.AND.VALUE<2> = 'TRD0001'
    D.LOGICAL.OPERANDS = ''
    D.LOGICAL.OPERANDS<1> = '1'
    D.LOGICAL.OPERANDS<2> = '1'

    R.GRP = ''
    R.GRP<SCB.EQD.ST.SEC.TRADE.ID,1> = 'TRD0001'
    R.GRP<SCB.EQD.ST.QUANTITY,1> = '1000'
    R.GRP<SCB.EQD.ST.TRADE.DATE,1> = '20260626'
    R.GRP<SCB.EQD.ST.VALUE.DATE,1> = '20260628'
    R.GRP<SCB.EQD.ST.AGGREGATED.TRANSFER.ID> = 'SECTSC2601293104'
    R.GRP<SCB.EQD.ST.ERROR> = ''
    UTF.setRecord("F.SCB.PVB.EQD.GROUP.TODAY", Y.GRP.ID, R.GRP)

    R.STE = ''
    R.STE<SC.STE.DESCRIPTION,1> = 'Hong Kong Stock Exchange'
    UTF.setRecord("F.STOCK.EXCHANGE", "SEHK", R.STE)

    R.STR = ''
    R.STR<SC.STR.NO.NOMINAL> = '1000'
    R.STR<SC.STR.DELIVERY.KEY,1> = 'DOH0001'
    R.STR<SC.STR.DELIVERY.KEY,2> = 'DOH0002'   ;* second id added purely to also exercise the MT543 branch below
    UTF.setRecord("F.SECURITY.TRANSFER", "SECTSC2601293104", R.STR)

    R.DOH = ''
    R.DOH<DE.HDR.MESSAGE.TYPE> = '541'
    R.DOH<DE.HDR.MSG.DISP,1> = 'MATCHED'
    UTF.setRecord("F.DE.O.HEADER", "DOH0001", R.DOH)

    R.DOH2 = ''
    R.DOH2<DE.HDR.MESSAGE.TYPE> = '543'
    R.DOH2<DE.HDR.MSG.DISP,1> = 'SETTLED'
    UTF.setRecord("F.DE.O.HEADER", "DOH0002", R.DOH2)

    R.TRD = ''
    R.TRD<SC.SBS.CUST.TRANS.CODE> = 'CUST001'
    R.TRD<SC.SBS.SECURITY.CODE> = 'SEC0001'
    UTF.setRecord("F.SEC.TRADE", "TRD0001", R.TRD)

    R.SM = ''
    R.SM<SC.SCM.I.S.I.N.> = 'HK0000012345'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0001", R.SM)
* set stubs for this test
* addParameter
    FINAL.ARRAY = ''
    UTF.addParam(FINAL.ARRAY)
    UTF.runTest("MT541 delivery message sets the disposition on the detail row")
* doAssertions for this testcase
    UTF.assertEquals(FIELD(FINAL.ARRAY<1>,'*',21), "MATCHED")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase6>
*** <desc> Trade no longer exists on the live SEC.TRADE file (e.g. it has been superseded) ->
            F.READ fails and the routine falls back to EB.READ.HISTORY.REC on F.SEC.TRADE$HIS</desc>

runtest6:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
    Y.GRP.ID = 'EQD.1.SEC0001.HKSCC.HKD.SEHK.CUST001.10.50.20260626.20260628.20260830'

    D.FIELDS = ''
    D.FIELDS<1,1> = 'TRADE.DATE'
    D.FIELDS<1,2> = 'SEC.TRADE.ID'
    D.RANGE.AND.VALUE = ''
    D.RANGE.AND.VALUE<1> = '20260626'
    D.RANGE.AND.VALUE<2> = 'TRD0007-1'
    D.LOGICAL.OPERANDS = ''
    D.LOGICAL.OPERANDS<1> = '1'
    D.LOGICAL.OPERANDS<2> = '1'

    R.GRP = ''
    R.GRP<SCB.EQD.ST.SEC.TRADE.ID,1> = 'TRD0007-1'
    R.GRP<SCB.EQD.ST.QUANTITY,1> = '300'
    R.GRP<SCB.EQD.ST.TRADE.DATE,1> = '20260626'
    R.GRP<SCB.EQD.ST.VALUE.DATE,1> = '20260628'
    R.GRP<SCB.EQD.ST.AGGREGATED.TRANSFER.ID> = ''
    R.GRP<SCB.EQD.ST.ERROR> = ''
    UTF.setRecord("F.SCB.PVB.EQD.GROUP.TODAY", Y.GRP.ID, R.GRP)

    R.STE = ''
    R.STE<SC.STE.DESCRIPTION,1> = 'Hong Kong Stock Exchange'
    UTF.setRecord("F.STOCK.EXCHANGE", "SEHK", R.STE)

*   deliberately no UTF.setRecord for F.SEC.TRADE "TRD0007" - forces the live read to fail
    R.TRD.HIS = ''
    R.TRD.HIS<SC.SBS.CUST.TRANS.CODE> = 'CUST001'
    R.TRD.HIS<SC.SBS.SECURITY.CODE> = 'SEC0001'
    UTF.setRecord("F.SEC.TRADE$HIS", "TRD0007", R.TRD.HIS)

    R.SM = ''
    R.SM<SC.SCM.I.S.I.N.> = 'HK0000012345'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0001", R.SM)
* set stubs for this test
* addParameter
    FINAL.ARRAY = ''
    UTF.addParam(FINAL.ARRAY)
    UTF.runTest("Trade missing from the live file falls back to the history file")
* doAssertions for this testcase
    UTF.assertEquals(FIELD(FINAL.ARRAY<1>,'*',14), "CUST001")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase7>
*** <desc> Coverage case - TRADE.DATE supplied as a range (operand RG=2, exercising the
            CONVERT @SM TO @VM / GE..LE branch), plus DEPOSITORY, Stk.Exch and
            AGGREGATED.TRANSFER.ID all supplied together, exercising the three LOCATE blocks
            that no earlier test case touches</desc>

runtest7:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
    Y.GRP.ID = 'EQD.1.SEC0010.HKSCC.HKD.SEHK.CUST010.12.00.20260615.20260617.20260830'

    D.FIELDS = ''
    D.FIELDS<1,1> = 'TRADE.DATE'
    D.FIELDS<1,2> = 'DEPOSITORY'
    D.FIELDS<1,3> = 'Stk.Exch'
    D.FIELDS<1,4> = 'AGGREGATED.TRANSFER.ID'
    D.RANGE.AND.VALUE = ''
    D.RANGE.AND.VALUE<1> = '20260601':@SM:'20260630'
    D.RANGE.AND.VALUE<2> = 'HKSCC'
    D.RANGE.AND.VALUE<3> = 'SEHK'
    D.RANGE.AND.VALUE<4> = 'SECTSC2601293999'
    D.LOGICAL.OPERANDS = ''
    D.LOGICAL.OPERANDS<1> = '2'    ;* RG (range)

    R.GRP = ''
    R.GRP<SCB.EQD.ST.SEC.TRADE.ID,1> = 'TRD0010'
    R.GRP<SCB.EQD.ST.QUANTITY,1> = '400'
    R.GRP<SCB.EQD.ST.TRADE.DATE,1> = '20260615'
    R.GRP<SCB.EQD.ST.VALUE.DATE,1> = '20260617'
    R.GRP<SCB.EQD.ST.AGGREGATED.TRANSFER.ID> = 'SECTSC2601293999'
    R.GRP<SCB.EQD.ST.ERROR> = ''
    UTF.setRecord("F.SCB.PVB.EQD.GROUP.TODAY", Y.GRP.ID, R.GRP)

    R.STE = ''
    R.STE<SC.STE.DESCRIPTION,1> = 'Hong Kong Stock Exchange'
    UTF.setRecord("F.STOCK.EXCHANGE", "SEHK", R.STE)

    R.STR = ''
    R.STR<SC.STR.NO.NOMINAL> = '400'
    UTF.setRecord("F.SECURITY.TRANSFER", "SECTSC2601293999", R.STR)

    R.TRD = ''
    R.TRD<SC.SBS.CUST.TRANS.CODE> = 'CUST010'
    R.TRD<SC.SBS.SECURITY.CODE> = 'SEC0010'
    UTF.setRecord("F.SEC.TRADE", "TRD0010", R.TRD)

    R.SM = ''
    R.SM<SC.SCM.I.S.I.N.> = 'HK0000099999'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0010", R.SM)
* set stubs for this test
* addParameter
    FINAL.ARRAY = ''
    UTF.addParam(FINAL.ARRAY)
    UTF.runTest("TRADE.DATE range plus DEPOSITORY/Stk.Exch/AGGREGATED.TRANSFER.ID filters")
* doAssertions for this testcase
    UTF.assertEquals(FIELD(FINAL.ARRAY<1>,'*',5), "TRD0010")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase8>
*** <desc> Coverage case - AUTH.DATE with operand LT(3) and VALUE.DATE with operand GT(4),
            exercising the "operand NE 2" branch of GETOPERAND for both fields with a
            non-EQ operator</desc>

runtest8:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
    Y.GRP.ID = 'EQD.1.SEC0011.HKSCC.HKD.SEHK.CUST011.8.00.20260620.20260625.20260830'

    D.FIELDS = ''
    D.FIELDS<1,1> = 'TRADE.DATE'
    D.FIELDS<1,2> = 'AUTH.DATE'
    D.FIELDS<1,3> = 'VALUE.DATE'
    D.RANGE.AND.VALUE = ''
    D.RANGE.AND.VALUE<1> = '20260620'
    D.RANGE.AND.VALUE<2> = '20260701'
    D.RANGE.AND.VALUE<3> = '20260610'
    D.LOGICAL.OPERANDS = ''
    D.LOGICAL.OPERANDS<1> = '1'    ;* EQ (mandatory field, unrelated to the coverage being added)
    D.LOGICAL.OPERANDS<2> = '3'    ;* LT
    D.LOGICAL.OPERANDS<3> = '4'    ;* GT

    R.GRP = ''
    R.GRP<SCB.EQD.ST.SEC.TRADE.ID,1> = 'TRD0011'
    R.GRP<SCB.EQD.ST.QUANTITY,1> = '250'
    R.GRP<SCB.EQD.ST.TRADE.DATE,1> = '20260620'
