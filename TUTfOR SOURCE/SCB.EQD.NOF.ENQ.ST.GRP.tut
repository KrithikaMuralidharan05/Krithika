TESTCASE SCB.EQD.NOF.ENQ.ST.GRP
*-----------------------------------------------------------------------------
* @author     :
*-----------------------------------------------------------------------------
*
*   Modification History :
*
*
*-----------------------------------------------------------------------------
    $INSERT I_COMMON
    $INSERT I_EQUATE
    $INSERT I_ENQUIRY.COMMON
    $INSERT I_F.SCB.PVB.EQD.GROUP.TODAY
    $INSERT I_F.SECURITY.TRANSFER
    $INSERT I_F.STOCK.EXCHANGE
    $INSERT I_F.DE.HEADER
    $INSERT I_F.SEC.TRADE
    $INSERT I_F.SECURITY.MASTER

    UTF.setTarget("SCB.EQD.NOF.ENQ.ST.GRP")
    UTF.setDescription("Test SCB.EQD.NOF.ENQ.ST.GRP routine")
    GOSUB runtest1
    GOSUB runtest2
    GOSUB runtest3

    RETURN

runtest1:

    UTF.reset() ;* Reset all
    UTF.addParam("Param1")
    GOSUB setSharedDetails
    GOSUB setSharedStubs
    GOSUB setSelectStub.Found
    UTF.runTest("Testing enquiry with TRADE.DATE filter - group found with included trade")
    UTF.assertEquals(UTF.getNbInvocation(ebrStub), "1")
    TRD.REC = UTF.getRecord("F.SCB.PVB.EQD.GROUP.TODAY", GRP.ID)
    UTF.assertEquals(TRD.REC<SCB.EQD.ST.SEC.TRADE.ID>, "ST12345")

RETURN

runtest2:

    UTF.reset() ;* Reset all
    UTF.addParam("Param1")
    GOSUB setSharedDetails
    GOSUB setSharedStubs
    GOSUB setSelectStub.NotFound
    UTF.runTest("Testing enquiry with no group matching the selection criteria")
    UTF.assertEquals(UTF.getNbInvocation(ebrStub), "1")

RETURN

runtest3:

    UTF.reset() ;* Reset all
    UTF.addParam("Param1")
    GOSUB setSharedDetails
    GOSUB setSharedStubs
    GOSUB setSelectStub.Found
*   override the enquiry criteria for this test - AUTHORISATION.DATE range (operand 2)
    D.FIELDS = ''; D.RANGE.AND.VALUE = ''; D.LOGICAL.OPERANDS = ''
    D.FIELDS<1,1> = 'AUTHORISATION.DATE'
    D.RANGE.AND.VALUE<1> = '20260701':@SM:'20260731'
    D.LOGICAL.OPERANDS<1> = '2'
    UTF.runTest("Testing enquiry with AUTHORISATION.DATE range filter")
    UTF.assertEquals(UTF.getNbInvocation(ebrStub), "1")

RETURN

setSharedStubs:

    multiGetLocRefStub = UTF.addStub("MULTI.GET.LOC.REF")
    UTF.addStubParam(multiGetLocRefStub, "SECURITY.TRANSFER", UTF.same())
    UTF.addStubParam(multiGetLocRefStub, "97A.SAFE.FIAC", UTF.same())
    UTF.addStubParam(multiGetLocRefStub, UTF.any(), '1')
    UTF.setRepeatable(multiGetLocRefStub)

RETURN

setSelectStub.Found:
*   CALL EB.READLIST(SEL.CMD,SEL.LIST,'',SEL.CNT,SEL.ERR) - GRP.ID set in setSharedDetails
    ebrStub = UTF.addStub("EB.READLIST")
    UTF.addStubParam(ebrStub, UTF.any(), UTF.same())        ;* SEL.CMD (in)
    UTF.addStubParam(ebrStub, UTF.any(), GRP.ID)             ;* SEL.LIST (out)
    UTF.addStubParam(ebrStub, UTF.any(), UTF.same())        ;* list name (in, blank)
    UTF.addStubParam(ebrStub, UTF.any(), '1')                ;* SEL.CNT (out)
    UTF.addStubParam(ebrStub, UTF.any(), UTF.same())        ;* SEL.ERR (out)
    UTF.setRepeatable(ebrStub)

RETURN

setSelectStub.NotFound:

    ebrStub = UTF.addStub("EB.READLIST")
    UTF.addStubParam(ebrStub, UTF.any(), UTF.same())        ;* SEL.CMD (in)
    UTF.addStubParam(ebrStub, UTF.any(), '')                  ;* SEL.LIST (out) - nothing found
    UTF.addStubParam(ebrStub, UTF.any(), UTF.same())        ;* list name (in, blank)
    UTF.addStubParam(ebrStub, UTF.any(), '0')                 ;* SEL.CNT (out)
    UTF.addStubParam(ebrStub, UTF.any(), UTF.same())        ;* SEL.ERR (out)

RETURN

setSharedDetails:

    D.FIELDS = ''; D.RANGE.AND.VALUE = ''; D.LOGICAL.OPERANDS = ''
    D.FIELDS<1,1> = 'TRADE.DATE'
    D.RANGE.AND.VALUE<1> = '20260727'

    GRP.ID = 'EQD.1.200836-000.6010.SGD.120'

*   -- Group record (SCB.PVB.EQD.GROUP.TODAY)
    R.SCB.PVB.EQD.GROUP.TODAY = ''
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.ERROR>                     = ''
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.SEC.TRADE.ID>              = 'ST12345'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.AGGREGATED.TRANSFER.ID>    = 'SECTSC2601293104'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.AGGREGATED.STATUS>         = 'AGGR'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.AUTH.DATE>                 = '20260728'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.QUANTITY>                  = '1000'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.TRADE.DATE>                = '20260727'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.VALUE.DATE>                = '20260729'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD>          = '100.10'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.BR.MISC.FEE>               = '1.00'
    R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.SEC.TRADE.ID.NOT.INCLUDED> = ''
    UTF.setRecord("F.SCB.PVB.EQD.GROUP.TODAY", GRP.ID, R.SCB.PVB.EQD.GROUP.TODAY)

*   -- Security transfer record
    R.SECURITY.TRANSFER = ''
    R.SECURITY.TRANSFER<SC.STR.NO.NOMINAL>       = '1000'
    R.SECURITY.TRANSFER<SC.STR.BR.NET.AMT>       = '100.10'
    R.SECURITY.TRANSFER<SC.STR.TRANSACTION.TYPE> = 'SEL'
    R.SECURITY.TRANSFER<SC.STR.SECURITY.CCY>     = 'SGD'
    R.SECURITY.TRANSFER<SC.STR.DELIVERY.KEY>     = ''
    R.SECURITY.TRANSFER<SC.STR.LOCAL.REF,1>      = '1001234'
    UTF.setRecord("F.SECURITY.TRANSFER", 'SECTSC2601293104', R.SECURITY.TRANSFER)

*   -- Sec trade record
    R.SEC.TRADE = ''
    R.SEC.TRADE<SC.SBS.CUST.TRANS.CODE> = 'CUST001'
    R.SEC.TRADE<SC.SBS.SECURITY.CODE>   = 'SEC001'
    UTF.setRecord("F.SEC.TRADE", 'ST12345', R.SEC.TRADE)

*   -- Security master record
    R.SECURITY.MASTER = ''
    R.SECURITY.MASTER<SC.SCM.I.S.I.N.> = 'SG1234567890'
    UTF.setRecord("F.SECURITY.MASTER", 'SEC001', R.SECURITY.MASTER)

*   -- Stock exchange record (code taken from position 6 of GRP.ID, i.e. '6010')
    R.STOCK.EXCHANGE = ''
    R.STOCK.EXCHANGE<SC.STE.DESCRIPTION,1> = 'SINGAPORE EXCHANGE'
    UTF.setRecord("F.STOCK.EXCHANGE", '6010', R.STOCK.EXCHANGE)

RETURN
END
