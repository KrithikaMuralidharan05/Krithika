    GOSUB setSharedStubs 
    ID.COMPANY = 'JE0010123'
    R.DIARY<1> = 'ENT1'
	R.DIARY<SC.DIA.NEW.PRICE> = '100'
    R.DIARY<SC.DIA.OLD.RATIO> = '0.23'
    R.DIARY<SC.DIA.NEW.RATIO> = '0.25'
