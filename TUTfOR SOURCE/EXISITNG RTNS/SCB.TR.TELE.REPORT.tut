RETURN
*-----------------------------------------------------------------------------
runtest1:
**********
    UTF.reset() ;* Reset all

    UTF.addParam("069076-260")
    GOSUB setSharedDetails ;*Commons if any required for all test cases
    
    R.SM = ''
    R.SM<SC.SCM.SHORT.NAME> = 'Wharf REIC Finance BVI Ltd WREICL 2'
    R.SM<SC.SCM.LOCAL.REF,1,1> = '100'
    R.SM<SC.SCM.STK.EXCH.PRICE> = '361'
    R.SM<SC.SCM.LOCAL.REF,2,1> = '20260107'
    R.SM<SC.SCM.LOCAL.REF,3> =''
    R.SM<SC.SCM.LAST.PRICE,1> = '100'
    R.SM<SC.SCM.DATE.LAST.PRICE> = '20260112'
    R.SM<SC.SCM.SECURITY.CURRENCY> = 'SGD'
    R.SM<SC.SCM.SUB.ASSET.TYPE> = '100'
    R.SM<SC.SCM.PRICE.UPDATE.CODE> = '40'
    UTF.setRecord('F.SECURITY.MASTER', "069076-260", R.SM)
    
    UTF.runTest("Test the SCB.TR.TELE.REPORT routine")
    UTF.assertTrue("TRUE")
    
RETURN
