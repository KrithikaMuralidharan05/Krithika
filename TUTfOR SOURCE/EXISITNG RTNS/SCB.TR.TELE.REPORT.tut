*** <region = Header>
*** <desc> </desc>
 
    $INSERT I_COMMON
    $INSERT I_EQUATE
    $INSERT I_BATCH.FILES
    $INSERT I_F.SECURITY.MASTER
    $INSERT I_F.SCB.WM.H.LOCAL.PARAM
    $INSERT I_SCB.TR.TELE.REPORT.COMMON
    $INSERT I_F.SCB.TR.PRICE.RESPONSE
    
    UTF.setTarget("SCB.TR.TELE.REPORT")                    ;* Name of the Target routine for which test is done
