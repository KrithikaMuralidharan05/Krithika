TESTCASE "SCB.INP.DEF.BR.AMT_EQD"

INITIALISE

* Mock SECURITY.TRANSFER input
SET R.NEW(SC.STR.LOCAL.REF)<1,1> = "EQD.TEST.GRP.USD.001"

* Mock record returned by F.READ
SET R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.SEC.TRADE.ID> = "TRD001"
SET R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,1> = "100"
SET R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,2> = "200"
SET R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,3> = "300"

CALL "SCB.INP.DEF.BR.AMT"

ASSERT R.NEW(SC.STR.BR.NET.AMT) = "600"
ASSERT R.NEW(SC.STR.CUST.NET.AMT) = "600"

ENDTEST



TESTCASE "SCB.INP.DEF.BR.AMT_NON_EQD"

INITIALISE

* Triggers IF Y.GRP.ID[1,3] NE "EQD"
SET R.NEW(SC.STR.LOCAL.REF)<1,1> = "PREFIX1EQD.TEST.GRP.USD.002"

SET R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.SEC.TRADE.ID> = "TRD002"
SET R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,1> = "500"
SET R.SCB.PVB.EQD.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,2> = "250"

CALL "SCB.INP.DEF.BR.AMT"

ASSERT R.NEW(SC.STR.BR.NET.AMT) = "750"
ASSERT R.NEW(SC.STR.CUST.NET.AMT) = "750"

ENDTEST
