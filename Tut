TESTCASE SCB.INP.DEF.BR.AMT

$INSERT I_COMMON
$INSERT I_EQUATE
$INSERT I_F.SECURITY.TRANSFER
$INSERT I_F.SCB.PVB.EQD.GROUP.TODAY

    UTF.setTarget("SCB.INP.DEF.BR.AMT")
    UTF.setDescription("Default BR Amount and Customer Amount")

    GOSUB runtest1
    GOSUB runtest2

    RETURN

*--------------------------------------------------------------------
* Test Case 1
* Group ID starts with EQD
*--------------------------------------------------------------------
runtest1:

    UTF.reset()

    Y.GRP.ID = "EQD123456"

    EXPECTED.AMT = "600"

    GOSUB setSharedDetails
    GOSUB setSharedStubs

    UTF.runTest("EQD Group Id")

    UTF.assertEquals(EXPECTED.AMT,R.NEW(SC.STR.BR.NET.AMT))
    UTF.assertEquals(EXPECTED.AMT,R.NEW(SC.STR.CUST.NET.AMT))

    RETURN

*--------------------------------------------------------------------
* Test Case 2
* Group ID does not start with EQD
*--------------------------------------------------------------------
runtest2:

    UTF.reset()

    Y.GRP.ID = "1234567EQD99999"

    EXPECTED.AMT = "750"

    GOSUB setSharedDetails2
    GOSUB setSharedStubs

    UTF.runTest("NON EQD Group Id")

    UTF.assertEquals(EXPECTED.AMT,R.NEW(SC.STR.BR.NET.AMT))
    UTF.assertEquals(EXPECTED.AMT,R.NEW(SC.STR.CUST.NET.AMT))

    RETURN

*--------------------------------------------------------------------
setSharedStubs:

    UTF.ignoreMissingStubs()

    RETURN

*--------------------------------------------------------------------
setSharedDetails:

    R.NEW = ''

    R.NEW(SC.STR.LOCAL.REF) = Y.GRP.ID

    R.GROUP.TODAY = ''

    R.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,1> = "100"
    R.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,2> = "200"
    R.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,3> = "300"

    UTF.setRecord(F.SCB.PVB.EQD.GROUP.TODAY,
                  Y.GRP.ID,
                  R.GROUP.TODAY)

    UTF.addParam(R.NEW)

    RETURN

*--------------------------------------------------------------------
setSharedDetails2:

    R.NEW = ''

    R.NEW(SC.STR.LOCAL.REF) = Y.GRP.ID

    R.GROUP.TODAY = ''

    R.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,1> = "500"
    R.GROUP.TODAY<SCB.EQD.ST.BR.GROSS.AMT.TRD,2> = "250"

    UTF.setRecord(F.SCB.PVB.EQD.GROUP.TODAY,
                  "EQD99999",
                  R.GROUP.TODAY)

    UTF.addParam(R.NEW)

    RETURN

END
