TESTCASE B.SCB.STMP.DTY.EXEP
*-----------------------------------------------------------------------------
* @author     :  Raghavan K
*-----------------------------------------------------------------------------
*
*   Modification History :
*
*   [8220461] - [18th Sep 2026] - [15990649] - Worker for the Stamp Duty exemption extract batch.
*
*-----------------------------------------------------------------------------
*** <region = Header>
*** <desc> </desc>
    $INSERT I_COMMON
    $INSERT I_EQUATE
    $INSERT I_F.SECURITY.MASTER

    UTF.setTarget("B.SCB.STMP.DTY.EXEP")   ;* Name of the Target routine for which test is done
    UTF.setDescription("Batch worker - clears LWM.GSD to 0 on SECURITY.MASTER records returned by either SELECT")
    GOSUB runtest1      ;* EB.READLIST returns a single id - it is reset to 0
    GOSUB runtest2      ;* EB.READLIST returns several ids in one list - the REMOVE...SETTING loop resets all of them
    GOSUB runtest3      ;* EB.READLIST returns an empty list - record is left untouched, no error
    GOSUB runtest4      ;* EB.READLIST returns a SEL.ERR - routine still completes without raising an error
*
    RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase1>
*** <desc> EB.READLIST hands back a single matching id -> SELECT.STMT reads it, zeroes
            LWM.GSD and writes the record back via F.LIVE.WRITE</desc>

runtest1:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs        ;* MULTI.GET.LOC.REF stub required for all test cases
* set data for this test
    R.SM = ''
    R.SM<SC.SCM.STOCK.EXCHANGE> = '104'
    R.SM<SC.SCM.SUB.ASSET.TYPE> = '118'
    R.SM<SC.SCM.LOCAL.REF,POS.LWM.GSD> = '1'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0001", R.SM)
* set stubs for this test
    STUB.SEL = UTF.addStub("EB.READLIST")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())     ;* SEL.CMD (in only)
    UTF.addStubParam(STUB.SEL, UTF.any(), "SEC0001")      ;* Y.SEL.LIST out
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())     ;* '' passthrough
    UTF.addStubParam(STUB.SEL, UTF.any(), "1")            ;* NO.OF.RECS out
    UTF.addStubParam(STUB.SEL, UTF.any(), "")             ;* SEL.ERR out
    UTF.setRepeatable(STUB.SEL)     ;* SELECT.STMT is called once per SELECT, i.e. twice per run
* addParameter
    UTF.runTest("Single matching security has LWM.GSD reset to 0")
    SM.REC = UTF.getRecord("F.SECURITY.MASTER", "SEC0001")
* doAssertions for this testcase
    UTF.assertEquals(SM.REC<SC.SCM.LOCAL.REF,POS.LWM.GSD>, "0")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase2>
*** <desc> EB.READLIST hands back more than one id in the same list - exercises the
            LOOP / REMOVE...SETTING loop processing multiple entries in a single call</desc>

runtest2:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
    R.SM1 = ''
    R.SM1<SC.SCM.STOCK.EXCHANGE> = '104'
    R.SM1<SC.SCM.SUB.ASSET.TYPE> = '118'
    R.SM1<SC.SCM.LOCAL.REF,POS.LWM.GSD> = '2'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0002", R.SM1)

    R.SM2 = ''
    R.SM2<SC.SCM.STOCK.EXCHANGE> = '361'
    R.SM2<SC.SCM.COMPANY.DOMICILE> = 'IE'
    R.SM2<SC.SCM.LOCAL.REF,POS.LWM.GSD> = '3'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0003", R.SM2)
* set stubs for this test
    STUB.SEL = UTF.addStub("EB.READLIST")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "SEC0002":@FM:"SEC0003")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "2")
    UTF.addStubParam(STUB.SEL, UTF.any(), "")
    UTF.setRepeatable(STUB.SEL)
* addParameter
    UTF.runTest("Both securities returned in the list are reset to 0")
    SM1.REC = UTF.getRecord("F.SECURITY.MASTER", "SEC0002")
    SM2.REC = UTF.getRecord("F.SECURITY.MASTER", "SEC0003")
* doAssertions for this testcase
    UTF.assertEquals(SM1.REC<SC.SCM.LOCAL.REF,POS.LWM.GSD>, "0")
    UTF.assertEquals(SM2.REC<SC.SCM.LOCAL.REF,POS.LWM.GSD>, "0")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase3>
*** <desc> EB.READLIST returns an empty list (no qualifying securities) -> the
            REMOVE...SETTING loop body never runs and the existing record is left untouched</desc>

runtest3:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
    R.SM = ''
    R.SM<SC.SCM.STOCK.EXCHANGE> = '206'    ;* not on either SELECT's exchange list
    R.SM<SC.SCM.LOCAL.REF,POS.LWM.GSD> = '9'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0004", R.SM)
* set stubs for this test
    STUB.SEL = UTF.addStub("EB.READLIST")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "0")
    UTF.addStubParam(STUB.SEL, UTF.any(), "")
    UTF.setRepeatable(STUB.SEL)
* addParameter
    UTF.runTest("Empty SEL.LIST leaves the security untouched")
    SM.REC = UTF.getRecord("F.SECURITY.MASTER", "SEC0004")
* doAssertions for this testcase
    UTF.assertEquals(SM.REC<SC.SCM.LOCAL.REF,POS.LWM.GSD>, "9")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase4>
*** <desc> EB.READLIST returns a SEL.ERR instead of a list -> SELECT.STMT still completes
            without raising an error (the routine does not check SEL.ERR before looping)</desc>

runtest4:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
    R.SM = ''
    R.SM<SC.SCM.STOCK.EXCHANGE> = '104'
    R.SM<SC.SCM.SUB.ASSET.TYPE> = '118'
    R.SM<SC.SCM.LOCAL.REF,POS.LWM.GSD> = '5'
    UTF.setRecord("F.SECURITY.MASTER", "SEC0005", R.SM)
* set stubs for this test
    STUB.SEL = UTF.addStub("EB.READLIST")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "0")
    UTF.addStubParam(STUB.SEL, UTF.any(), "Selection failed")
    UTF.setRepeatable(STUB.SEL)
* addParameter
    UTF.runTest("A SEL.ERR from EB.READLIST does not stop the routine")
    SM.REC = UTF.getRecord("F.SECURITY.MASTER", "SEC0005")
* doAssertions for this testcase
    UTF.assertEquals(SM.REC<SC.SCM.LOCAL.REF,POS.LWM.GSD>, "5")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= Stubs common for all test cases>
*** <desc> OPEN.FILES calls MULTI.GET.LOC.REF once to resolve the LWM.GSD local ref position
            on SECURITY.MASTER - stub it to hand back position 1, matching POS.LWM.GSD used
            to build each test's mock record above.</desc>

setSharedStubs:
    POS.LWM.GSD = '1'

    STUB.LOC = UTF.addStub("MULTI.GET.LOC.REF")
    UTF.addStubParam(STUB.LOC, UTF.any(), UTF.same())    ;* LOC.REF.APP ('SECURITY.MASTER')
    UTF.addStubParam(STUB.LOC, UTF.any(), UTF.same())    ;* LOC.REF.FLD ('LWM.GSD')
    UTF.addStubParam(STUB.LOC, UTF.any(), POS.LWM.GSD)   ;* LOC.REF.POS output -> position 1
    UTF.setRepeatable(STUB.LOC)

    RETURN
*** </region>
*-----------------------------------------------------------------------------
END
