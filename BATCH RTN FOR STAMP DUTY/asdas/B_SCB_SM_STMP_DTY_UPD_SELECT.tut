TESTCASE B.SCB.SM.STMP.DTY.UPD.SELECT
*-----------------------------------------------------------------------------
* @author     :  Raghavan K
*-----------------------------------------------------------------------------
*
*   Modification History :
*
*   <date> - <ADO ref> - <author> - SELECT step of the multi-threaded Stamp Duty exemption batch.
*
*-----------------------------------------------------------------------------
*** <region = Header>
*** <desc> </desc>
    $INSERT I_COMMON
    $INSERT I_EQUATE
    $INSERT I_F.SECURITY.MASTER
    $INSERT I_B.SCB.SM.STMP.DTY.UPD.COMMON

    UTF.setTarget("B.SCB.SM.STMP.DTY.UPD.SELECT")   ;* Name of the Target routine for which test is done
    UTF.setDescription("SELECT step - merges both SELECTs' id lists and hands them to BATCH.BUILD.LIST")
    GOSUB runtest1      ;* EB.READLIST returns ids on both calls - both SEL.LIST<-1>= appends fire
    GOSUB runtest2      ;* EB.READLIST returns an empty list on both calls - SEL.LIST stays ''
*
    RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase1>
*** <desc> EB.READLIST is stubbed generically (UTF.any() on SEL.CMD) since this framework's
            UTF.addStubParam does not accept a long literal match string containing embedded
            quote characters - the same stub response is returned for both the STOCK.EXCHANGE
            104 and the STOCK.EXCHANGE 361 SELECT, so this exercises both
            IF SEL.LIST1 THEN SEL.LIST<-1>=SEL.LIST1 and IF SEL.LIST2 THEN SEL.LIST<-1>=SEL.LIST2
            firing, confirming the merge appends on every non-blank result rather than
            confirming which literal SELECT produced it</desc>

runtest1:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs        ;* resets FN.SECURITY.MASTER/F.SECURITY.MASTER for every test case
* set data for this test
* set stubs for this test
    STUB.SEL = UTF.addStub("EB.READLIST")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())     ;* SEL.CMD (in only)
    UTF.addStubParam(STUB.SEL, UTF.any(), "SEC0001")      ;* SEL.LIST out
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())     ;* '' passthrough
    UTF.addStubParam(STUB.SEL, UTF.any(), "1")            ;* NO.OF.RECS out
    UTF.addStubParam(STUB.SEL, UTF.any(), "")             ;* SEL.ERR out
    UTF.setRepeatable(STUB.SEL)     ;* SELECT.PARA calls EB.READLIST twice per run - once per SELECT

    STUB.BLD = UTF.addStub("BATCH.BUILD.LIST")
    UTF.addStubParam(STUB.BLD, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.BLD, UTF.any(), UTF.same())
    UTF.setRepeatable(STUB.BLD)
* addParameter
    UTF.runTest("Both EB.READLIST calls returning ids triggers both merge appends")
* doAssertions for this testcase
    UTF.assertEquals(SEL.LIST, "SEC0001":@FM:"SEC0001")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= testcase2>
*** <desc> EB.READLIST returns an empty list on both calls - neither IF SEL.LIST1 THEN nor
            IF SEL.LIST2 THEN is taken, so SEL.LIST stays at its initialised '' value and
            BATCH.BUILD.LIST is still called cleanly with an empty list</desc>

runtest2:

    UTF.reset() ;* Reset all
    GOSUB setSharedStubs
* set data for this test
* set stubs for this test
    STUB.SEL = UTF.addStub("EB.READLIST")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "")
    UTF.addStubParam(STUB.SEL, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.SEL, UTF.any(), "0")
    UTF.addStubParam(STUB.SEL, UTF.any(), "")
    UTF.setRepeatable(STUB.SEL)

    STUB.BLD = UTF.addStub("BATCH.BUILD.LIST")
    UTF.addStubParam(STUB.BLD, UTF.any(), UTF.same())
    UTF.addStubParam(STUB.BLD, UTF.any(), UTF.same())
    UTF.setRepeatable(STUB.BLD)
* addParameter
    UTF.runTest("Neither SELECT returning anything still completes without error")
* doAssertions for this testcase
    UTF.assertEquals(SEL.LIST, "")

RETURN
*** </region>
*-----------------------------------------------------------------------------
*** <region name= Stubs common for all test cases>
*** <desc> SELECT always runs before LOAD in the batch sequence, so it opens
            F.SECURITY.MASTER itself rather than relying on COMMON - no stub is needed for
            CALL OPF itself (it is a plain file open, like F.READ, and works against the mock
            file store directly), this just resets FN.SECURITY.MASTER/F.SECURITY.MASTER so
            each test starts from the same blank state. CALL OCOMO runs unconditionally after
            the merge (logging SEL.LIST before BATCH.BUILD.LIST) and needs a no-op stub too.</desc>

setSharedStubs:
    FN.SECURITY.MASTER = ''
    F.SECURITY.MASTER = ''

    STUB.OCM = UTF.addStub("OCOMO")
    UTF.addStubParam(STUB.OCM, UTF.any(), UTF.same())    ;* message text (in only)
    UTF.setRepeatable(STUB.OCM)

    RETURN
*** </region>
*-----------------------------------------------------------------------------
END
